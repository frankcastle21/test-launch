[Unit]
Description=Sui signup test bot (sequential, local mock only)
After=network.target mock-site.service
Wants=mock-site.service

[Service]
User=suibot
WorkingDirectory=/opt/sui-signup-bot
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/sui-signup-bot/.browsers
ExecStart=/opt/sui-signup-bot/.venv/bin/python -m suibot \
    --db /var/lib/suibot/suibot.db \
    --passphrase-file /etc/suibot/passphrase \
    run --adapter mock --url http://127.0.0.1:8080 \
    --screenshots /var/lib/suibot/screenshots
# SIGTERM finishes the current step; progress is committed before each signup.
KillSignal=SIGTERM
TimeoutStopSec=90
# Restart after crashes and reboots (completed wallets are never repeated),
# but not after a CAPTCHA/human check (exit 3): that needs a person.
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=3
UMask=0077

[Install]
WantedBy=multi-user.target
