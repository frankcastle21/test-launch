# Suibot configuration.
# Read by systemd (EnvironmentFile=) and by the /usr/local/bin/suibot admin wrapper.
# Format: plain KEY=value lines. No spaces around '=', no quotes, no shell syntax.
# After editing: sudo systemctl restart suibot-mock suibot

# --- Storage ---------------------------------------------------------------
SUIBOT_DB=/var/lib/suibot/suibot.db
SUIBOT_PASSPHRASE_FILE=/etc/suibot/passphrase
SUIBOT_SCREENSHOTS=/var/lib/suibot/screenshots
SUIBOT_BACKUP_DIR=/var/lib/suibot/backups
SUIBOT_BACKUP_KEEP=14
SUIBOT_LOG_FILE=/var/log/suibot/suibot.log
SUIBOT_VERBOSE=0

# --- Signup target ---------------------------------------------------------
# Must be a loopback URL; the bot refuses anything else and the systemd unit
# blocks all non-localhost network traffic.
SUIBOT_ADAPTER=mock
SUIBOT_URL=http://127.0.0.1:8080

# --- Pacing and retries ----------------------------------------------------
SUIBOT_MIN_DELAY=240
SUIBOT_MAX_DELAY=420
SUIBOT_MAX_ATTEMPTS=3
SUIBOT_REFERRAL=

# --- Local mock signup site --------------------------------------------------
MOCK_HOST=127.0.0.1
MOCK_PORT=8080
MOCK_DATA=/var/lib/suibot/mock-signups.json
MOCK_LOG_FILE=/var/log/suibot/mock-site.log
# Failure injection for testing (0 = off): signups/min limit, CAPTCHA mode (1 = on), 500 rate.
MOCK_RATE_LIMIT_PER_MIN=0
MOCK_CAPTCHA=0
MOCK_FAIL_RATE=0
